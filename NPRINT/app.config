        <add name="NPRINT.My.MySettings.ConnectionString" connectionString="Provider=SQLOLEDB;Data Source=SVRSELCO\XSEL;Password=1234Clienti;User ID=selco;Initial Catalog=COGE" providerName="System.Data.OleDb"/>
